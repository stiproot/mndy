{
  "name": "mndy",
  "version": "0.1.0",
  "private": true,
  "description": "Project analytics platform for Azure DevOps",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/js/*",
    "scripts"
  ],
  "scripts": {
    "build": "turbo build",
    "lint": "bun scripts/check-workspaces.mjs && bun scripts/check-plans.mjs && bun scripts/check-ports.mjs && bun scripts/check-hex-lint.mjs && bun scripts/check-mcp-parity.mjs && bun scripts/check-secrets.mjs && bun scripts/check-docker-workspace.mjs && bun run lint:md && bunx gen-code-diagram --check --dir docs/diagrams && turbo lint",
    "test": "turbo test",
    "check-ports": "bun scripts/check-ports.mjs",
    "check-hex-lint": "bun scripts/check-hex-lint.mjs",
    "lint:md": "markdownlint '**/*.md' --ignore node_modules --ignore '**/node_modules/**'",
    "lint:md:fix": "markdownlint '**/*.md' --ignore node_modules --ignore '**/node_modules/**' --fix",
    "test:integration": "vitest run tests/integration/",
    "test:integration:watch": "vitest tests/integration/",
    "test:integration:github": "vitest run tests/integration/github-issues-mcp/",
    "test:integration:ga4": "vitest run tests/integration/ga4-mcp/",
    "test:integration:meta": "vitest run tests/integration/meta-ads-mcp/",
    "test:integration:shopify": "vitest run tests/integration/shopify-mcp/",
    "test:integration:marketing": "vitest run tests/integration/ga4-mcp/ tests/integration/meta-ads-mcp/ tests/integration/shopify-mcp/",
    "insights": "bun run --cwd scripts src/contributor-insights.ts",
    "check-mcp-parity": "bun scripts/check-mcp-parity.mjs",
    "check-secrets": "bun scripts/check-secrets.mjs",
    "check-docker-workspace": "bun scripts/check-docker-workspace.mjs",
    "check-workspaces": "bun scripts/check-workspaces.mjs",
    "diagrams": "bunx gen-code-diagram --dir docs/diagrams",
    "check-plans": "bun scripts/check-plans.mjs"
  },
  "devDependencies": {
    "@stiproot/code-comprehension": "github:stiproot/code-comprehension",
    "dependency-cruiser": "^18.0.0",
    "dotenv": "^16.4.5",
    "effect": "^3.12.5",
    "markdownlint-cli": "^0.43.0",
    "turbo": "^2.9.16",
    "vitest": "^3.0.0"
  }
}
