# Google Ads MCP server
# Copy to .env and fill in. Never commit .env.

# --- Server ---
PORT=3010
LOG_LEVEL=info

# --- OAuth2 client (from Google Cloud Console > APIs & Services > Credentials) ---
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=

# --- Developer token (from Google Ads > Tools > API Center) ---
# A test-level token only reaches test accounts; production data needs an approved token.
GOOGLE_ADS_DEVELOPER_TOKEN=

# --- OAuth2 refresh token ---
# Generated once by consenting to the adwords scope with the client above.
# See the README for how to obtain it.
GOOGLE_ADS_REFRESH_TOKEN=

# --- Accounts ---
# The account to query when a tool call does not pass customerId.
# 10 digits; dashes are stripped automatically.
GOOGLE_ADS_CUSTOMER_ID=

# The manager (MCC) account to make requests THROUGH. Required when the customer above
# sits under a manager account — the usual agency setup. Leave blank otherwise.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
